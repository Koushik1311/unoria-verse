generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mood {
  happy
  sad
  angry
  anxious
  peaceful
  confused
  inspired
  lonely
  motivated
}

enum Tone {
  reflective // introspective, deep, emotional
  uplifting // positive, encouraging
  calming // soothing, peaceful
  empowering // motivational, strong
  playful // humorous, light-hearted
  comforting // warm, reassuring
  melancholic // nostalgic, bittersweet
  romantic // affectionate, love-centered
  neutral // factual, plain
  spiritual // mindful, existential
  energetic // high-energy, enthusiastic
}

model Quote {
  id        String   @id @default(cuid())
  content   String   @unique
  mood      Mood
  tone      Tone
  author    Author?  @relation(fields: [authorId], references: [id])
  authorId  String?
  createdAt DateTime @default(now())

  @@index([mood, tone])
}

model Author {
  id     String  @id @default(cuid())
  name   String  @unique
  quotes Quote[]
}
